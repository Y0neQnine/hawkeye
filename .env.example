# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
POSTGRES_USER=hawkeye
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=hawkeye

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 一键在线更新：容器无法直连 GitHub 时填代理（http://host:port）
HAWKEYE_UPDATE_PROXY=
# 可选：GitHub API 限流时填只读 token
HAWKEYE_UPDATE_GITHUB_TOKEN=
